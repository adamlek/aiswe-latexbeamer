\definecolor{aiswe-dark1}{RGB}{13, 31, 41}
\definecolor{aiswe-dark-blue}{RGB}{0, 77, 102}
\definecolor{aiswe-blue}{RGB}{0, 115, 153}
\definecolor{aiswe-light1}{RGB}{255, 254, 250}
\definecolor{aiswe-gray1}{RGB}{244, 242, 230}
\definecolor{aiswe-accent1}{RGB}{255, 200, 0}

\setbeamercolor*{background canvas}{bg=aiswe-dark1}

\setbeamercolor*{title}{fg=aiswe-light1}
\setbeamerfont{title}{size=\Huge}
\setbeamerfont{subtitle}{size=\large}

\setbeamercolor{frametitle-left}{fg=aiswe-light1}
\setbeamercolor{frametitle}{fg=aiswe-light1}
\setbeamerfont{frametitle}{size=\Large}
\setbeamerfont{framesubtitle}{size=\small}

\setbeamercolor{caption name}{fg=aiswe-light1}

% set color of all items
\setbeamercolor{local structure}{fg=aiswe-light1}

\setbeamercolor*{itemize item}{fg=aiswe-light1}
\setbeamercolor*{itemize subitem}{fg=aiswe-light1}
\setbeamercolor*{normal text}{fg=aiswe-light1}

\setbeamercolor{block body alerted}{bg=alerted text.fg!10}
\setbeamercolor{block title alerted}{bg=aiswe-gray1}
\setbeamercolor{block body}{bg=aiswe-gray1, fg=aiswe-dark1}
\setbeamercolor{block title}{bg=aiswe-dark-blue, fg=aiswe-gray1}
\setbeamercolor{block body example}{bg=green!10}
\setbeamercolor{block title example}{bg=green!20}